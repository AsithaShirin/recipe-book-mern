# Server Port
PORT=5000

# MongoDB Connection String (Atlas URI or local fallback)
# Evaluator / Developer: Replace with your MongoDB Atlas connection string or local MongoDB instance
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/recipe_book?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://testUser:testPassword123@cluster0.abcde.mongodb.net/recipe_book?retryWrites=true&w=majority&appName=Cluster0

# If using local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/recipe_book
